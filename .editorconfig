root = true

# https://pinterest.github.io/ktlint/latest/rules/configuration-ktlint/

[*.{kt,kts}]
max_line_length = 120
ktlint_code_style = ktlint_official
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ktlint_standard_annotation = disabled
ktlint_standard_multiline-expression-wrapping = disabled
ktlint_standard_property-naming = disabled
ktlint_standard_function-expression-body = disabled
ktlint_standard_chain-method-continuation = disabled
ktlint_standard_class-signature = disabled
ktlint_function_naming_ignore_when_annotated_with = Composable
ktlint_standard_modifier-order = disabled
ktlint_standard_function-signature = disabled

[**/internal/debug/**/*.{kt,kts}]
max_line_length = off

# EvgenAnalytics file is auto generated
# It uses 'ktlint-disable' comment which is deprecated, should be replaced with @Suppress annotation in future generator updates.
[**/EvgenAnalytics.kt]
ktlint_internal = disabled
ktlint_standard = disabled

# bdui-open-api-specs module is auto generated
# It uses 'ktlint-disable' comment which is deprecated, should be replaced with @Suppress annotation in future generator updates.
[**/bdui-open-api-specs/**/*.{kt,kts}]
ktlint_internal = disabled
ktlint_standard = disabled
